# ============================================================
# MindPro Billing Manager - Environment Configuration
# Copy this file to .env and configure values for the environment.
# Never commit real credentials or secrets.
# ============================================================

# Application
NODE_ENV=development
PORT=3001
SWAGGER_ENABLED=true

# CORS
CORS_ORIGINS=http://localhost:5173

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mindpro_crm_dev
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Authentication / Cognito
AWS_COGNITO_REGION=your-region
AWS_COGNITO_USERPOOL_ID=your-user-pool-id

# Internal service authentication
INTERNAL_API_KEY=change-me

# Receipts
RECEIPT_LOGO_URL=
