<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <title>
    Receipt {{receiptNumber}}
  </title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      font-family:
        Arial,
        Helvetica,
        sans-serif;
      color: #1f2937;
      background: #ffffff;
      font-size: 12px;
      line-height: 1.45;
    }

    .page {
      width: 100%;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 32px;
      padding-bottom: 18px;
      border-bottom: 2px solid #111827;
    }

    .brand-name {
      margin: 0;
      font-size: 24px;
      font-weight: 700;
      color: #111827;
    }

    .brand-subtitle {
      margin-top: 4px;
      color: #6b7280;
      font-size: 11px;
    }

    .receipt-title {
      text-align: right;
    }

    .receipt-title h1 {
      margin: 0;
      font-size: 26px;
      letter-spacing: 0.04em;
      color: #111827;
    }

    .receipt-number {
      margin-top: 6px;
      font-weight: 700;
      color: #374151;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-bottom: 24px;
    }

    .card {
      padding: 16px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }

    .card-title {
      margin: 0 0 10px;
      color: #6b7280;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .field {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 5px 0;
    }

    .label {
      color: #6b7280;
    }

    .value {
      font-weight: 600;
      text-align: right;
      color: #111827;
    }

    .amount-box {
      margin: 28px 0;
      padding: 22px;
      border: 2px solid #111827;
      border-radius: 10px;
      text-align: center;
    }

    .amount-label {
      color: #6b7280;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .amount-value {
      margin-top: 6px;
      font-size: 32px;
      font-weight: 700;
      color: #111827;
    }

    .description {
      margin-bottom: 24px;
      padding: 16px;
      background: #f9fafb;
      border-radius: 8px;
    }

    .description-title {
      margin-bottom: 6px;
      color: #6b7280;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .footer {
      margin-top: 40px;
      padding-top: 18px;
      border-top: 1px solid #e5e7eb;
      color: #6b7280;
      font-size: 10px;
      text-align: center;
    }

    .muted {
      color: #9ca3af;
    }

    .company-logo {
        display: block;
        width: 190px;
        max-height: 85px;
        margin: 0 0 12px;
        object-fit: contain;
        object-position: left center;
    }
  </style>
</head>

<body>
  <div class="page">
    <header class="header">
    <div>
        {{#if logoUrl}}
            <img
            src="{{logoUrl}}"
            alt="{{companyName}}"
            class="company-logo"
            />
        {{/if}}

        <h2 class="brand-name">
            {{companyName}}
        </h2>

        {{#if companyAddress}}
            <div class="brand-subtitle">
            {{companyAddress}}
            </div>
        {{/if}}

        {{#if companyPhone}}
            <div class="brand-subtitle">
            {{companyPhone}}
            </div>
        {{/if}}

        {{#if companyEmail}}
            <div class="brand-subtitle">
            {{companyEmail}}
            </div>
        {{/if}}
    </div>

      <div class="receipt-title">
        <h1>
          PAYMENT RECEIPT
        </h1>

        <div class="receipt-number">
          {{receiptNumber}}
        </div>
      </div>
    </header>

    <section class="grid">
      <div class="card">
        <div class="card-title">
          Payment information
        </div>

        <div class="field">
          <span class="label">
            Payment date
          </span>

          <span class="value">
            {{paymentDate}}
          </span>
        </div>

        <div class="field">
          <span class="label">
            Payment method
          </span>

          <span class="value">
            {{paymentMethodCode}}
          </span>
        </div>

        <div class="field">
          <span class="label">
            Reference
          </span>

          <span class="value">
            {{#if referenceNumber}}
              {{referenceNumber}}
            {{else}}
              <span class="muted">
                —
              </span>
            {{/if}}
          </span>
        </div>
      </div>

      <div class="card">
        <div class="card-title">
          Received from
        </div>

        <div class="field">
          <span class="label">
            Client
          </span>

          <span class="value">
            {{#if clientName}}
              {{clientName}}
            {{else}}
              <span class="muted">
                Not specified
              </span>
            {{/if}}
          </span>
        </div>

        <div class="field">
          <span class="label">
            Case
          </span>

          <span class="value">
            {{#if caseReference}}
              {{caseReference}}
            {{else}}
              <span class="muted">
                Not specified
              </span>
            {{/if}}
          </span>
        </div>
      </div>
    </section>

    <section class="amount-box">
      <div class="amount-label">
        Amount received
      </div>

      <div class="amount-value">
        {{currencySymbol}}{{amount}}
      </div>
    </section>

    {{#if description}}
      <section class="description">
        <div class="description-title">
          Description
        </div>

        <div>
          {{description}}
        </div>
      </section>
    {{/if}}

    <footer class="footer">
      Receipt issued on {{issuedAt}}.

      <br />

      This receipt confirms payment received
      and recorded in the billing system.
    </footer>
  </div>
</body>
</html>